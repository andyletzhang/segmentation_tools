/*
 * Dark theme (neutral)
 *
 * Grays carry a very slight warm cast so the app reads as neutral
 * rather than cold. Blue is used only to show selection, checked
 * state and keyboard focus. Tabs use gray alone.
 *
 * Palette
 *   canvas           #1c1c1c   image display area (true neutral)
 *   sunken           #1f1e1d   pressed, slider grooves, indicator fill
 *   background       #282726   window and panel background
 *   muted            #2d2c2b   disabled fill, unselected tabs, alternate rows
 *   surface          #333231   inputs, buttons, popups, headers
 *   disabled-border  #3c3b39
 *   raised           #3d3c3a   hover
 *   border           #484745
 *   selected         #4d4c4a   selected tab, popup highlight
 *   border-strong    #5e5c59
 *   handle           #6e6c68   scrollbar and slider handles
 *   indicator-border #7a7874   checkbox/radio outline, handle hover
 *   handle-pressed   #8c8985
 *   handle-light     #c9c6c1   range slider handle hover
 *   text-disabled    #75736f
 *   text-dim         #9a9792
 *   text             #ebe9e6
 *   accent           #3d95e0   focus, checked fills
 *   accent-hover     #5ba8ea
 *   accent-selection #2b78c4   selection behind white text
 *   accent-muted     #2b4a66   checked tool buttons
 *
 *   danger           #4a3332   border #684643
 *   danger-hover     #5a3c3a   border #7e5450
 *   danger-pressed   #362625
 *   danger-disabled  #2e2726   border #3b3332
 */

/* Base */
QWidget, QMainWindow, QMenuBar, QStatusBar {
    background-color: #282726;
    color: #ebe9e6;
    selection-background-color: #2b78c4;
    selection-color: #ffffff;
}

QMainWindow {
    border: 1px solid #1f1e1d;
}

QLabel {
    background-color: transparent;
}

QToolTip {
    background-color: #333231;
    color: #ebe9e6;
    border: 1px solid #484745;
    padding: 4px;
}

/* Image display area (objectName "imageCanvas") */
QWidget#imageCanvas {
    background-color: #1c1c1c;
}

/* Menu bar and menus */
QMenuBar::item {
    spacing: 20px;
    padding: 7px 12px;
    border: none;
    background-color: transparent;
}

QMenu {
    background-color: #333231;
    border: 1px solid #484745;
    padding: 4px;
}

QMenu::item {
    padding: 5px 20px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #3d3c3a;
}

QMenu::item:selected {
    background-color: #4d4c4a;
}

QMenuBar::item:pressed, QMenu::item:pressed {
    background-color: #1f1e1d;
}

QMenu::item:disabled {
    color: #75736f;
}

QMenu::separator {
    height: 1px;
    background-color: #484745;
    margin: 4px 8px;
}

/* Bordered containers */
QWidget#bordered {
    border: 2px solid #484745;
    border-radius: 6px;
    padding: 5px;
}

/* Buttons and text inputs */
QPushButton, QToolButton, QLineEdit, QTextEdit, QComboBox {
    background-color: #333231;
    color: #ebe9e6;
    border: 1px solid #484745;
    border-radius: 5px;
    padding: 5px;
}

QToolButton {
    padding: 4px;
}

QComboBox {
    padding-right: 22px;
    /* Some styles draw popup highlights from the combo's own palette */
    selection-background-color: #4d4c4a;
    selection-color: #ffffff;
}

QPushButton:hover, QToolButton:hover, QComboBox:hover {
    background-color: #3d3c3a;
    border-color: #5e5c59;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #1f1e1d;
}

/* Checked tool buttons */
QToolButton:checked {
    background-color: #2b4a66;
    border-color: #3d95e0;
}

QToolButton:checked:hover {
    border-color: #5ba8ea;
}

/* Flat tool buttons inside toolbars */
QToolBar QToolButton {
    background-color: transparent;
    border-color: transparent;
}

QToolBar QToolButton:hover {
    background-color: #3d3c3a;
    border-color: #5e5c59;
}

QToolBar QToolButton:checked {
    background-color: #2b4a66;
    border-color: #3d95e0;
}

/* Collapsible sections: expanded matches collapsed; the arrow shows state */
CollapsibleWidget QToolButton:checked,
CollapsibleWidget QPushButton:checked {
    background-color: #333231;
    border-color: #484745;
}

CollapsibleWidget QToolButton:checked:hover,
CollapsibleWidget QPushButton:checked:hover {
    background-color: #3d3c3a;
    border-color: #5e5c59;
}

CollapsibleWidget QToolButton:checked:focus,
CollapsibleWidget QPushButton:checked:focus {
    border-color: #3d95e0;
}

/* Default dialog button */
QPushButton:default {
    border-color: #5e5c59;
    font-weight: bold;
}

/* Keyboard focus (must follow hover and default rules) */
QLineEdit:focus, QTextEdit:focus,
QPushButton:focus, QToolButton:focus, QComboBox:focus {
    border-color: #3d95e0;
}

QPushButton:disabled, QToolButton:disabled, QLineEdit:disabled,
QTextEdit:disabled, QComboBox:disabled {
    background-color: #2d2c2b;
    color: #75736f;
    border: 1px solid #3c3b39;
}

/* Combo box popup list (rounded corners and item styling need
   rounded_combo_popup() from combo_popup.py) */
QComboBoxPrivateContainer {
    background-color: transparent;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #333231;
    color: #ebe9e6;
    border: 1px solid #484745;
    border-radius: 5px;
    padding: 2px;
    selection-background-color: #4d4c4a;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px 3px;
    border-radius: 3px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #4d4c4a;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:disabled {
    color: #75736f;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: url(icons:chevron_down.svg);
    width: 10px;
    height: 10px;
}

QComboBox::down-arrow:disabled {
    image: url(icons:chevron_down_disabled.svg);
}

/* Delete buttons */
QPushButton#deleteButton {
    background-color: #4a3332;
    border: 1px solid #684643;
}

QPushButton#deleteButton:hover {
    background-color: #5a3c3a;
    border-color: #7e5450;
}

QPushButton#deleteButton:pressed {
    background-color: #362625;
}

QPushButton#deleteButton:focus {
    border-color: #3d95e0;
}

QPushButton#deleteButton:disabled {
    background-color: #2e2726;
    color: #75736f;
    border: 1px solid #3b3332;
}

/* Item views and headers */
QAbstractItemView {
    background-color: #333231;
    alternate-background-color: #2d2c2b;
    border: 1px solid #484745;
}

QAbstractItemView:disabled {
    color: #75736f;
}

QHeaderView {
    background-color: #333231;
}

QHeaderView::section {
    background-color: #333231;
    color: #9a9792;
    border: none;
    border-right: 1px solid #484745;
    border-bottom: 1px solid #484745;
    padding: 4px;
}

/* Radio buttons and checkboxes */
QRadioButton, QCheckBox {
    background-color: transparent;
    spacing: 6px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: #1f1e1d;
    border: 1px solid #7a7874;
}

QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border-radius: 7px;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: #9a9792;
}

/* Checked radio: accent ring with a white center dot */
QRadioButton::indicator:checked {
    border: 1px solid #3d95e0;
    background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #ffffff, stop: 0.45 #ffffff, stop: 0.55 #3d95e0, stop: 1 #3d95e0);
}

/* Checked checkbox: accent fill with a white checkmark */
QCheckBox::indicator:checked {
    border: 1px solid #3d95e0;
    background-color: #3d95e0;
    image: url(icons:checkmark.svg);
}

QRadioButton::indicator:checked:hover, QCheckBox::indicator:checked:hover {
    border-color: #5ba8ea;
}

/* Focus ring: light on checked indicators so it shows against the fill */
QRadioButton::indicator:focus, QCheckBox::indicator:focus {
    border-color: #3d95e0;
}

QRadioButton::indicator:checked:focus, QCheckBox::indicator:checked:focus {
    border-color: #ebe9e6;
}

QRadioButton:disabled, QCheckBox:disabled {
    color: #75736f;
}

QRadioButton::indicator:disabled, QCheckBox::indicator:disabled {
    background-color: #2d2c2b;
    border: 1px solid #3c3b39;
}

QRadioButton::indicator:checked:disabled {
    background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #9a9792, stop: 0.45 #9a9792, stop: 0.55 #3c3b39, stop: 1 #3c3b39);
}

QCheckBox::indicator:checked:disabled {
    background-color: #3c3b39;
    image: url(icons:checkmark_disabled.svg);
}

/* Toolbar */
QToolBar {
    background-color: #333231;
    border: 1px solid #1f1e1d;
}

/* Splitter handles */
QSplitter::handle {
    background-color: #282726;
}

QSplitter::handle:hover {
    background-color: #5e5c59;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

/* Native tabs: selection shown by a lighter gray and underline, no accent */
QTabWidget::pane {
    border: 1px solid #484745;
    top: -1px;
}

QTabBar::tab {
    background-color: #2d2c2b;
    color: #9a9792;
    padding: 5px 10px;
    min-height: 20px;
    border: 1px solid #484745;
    border-bottom: 2px solid #484745;
    margin-right: -1px;
}

QTabBar::tab:hover {
    background-color: #3d3c3a;
    color: #ebe9e6;
}

QTabBar::tab:selected {
    background-color: #4d4c4a;
    color: #ffffff;
    border-color: #5e5c59;
    border-bottom-color: #ebe9e6;
}

QTabBar::tab:disabled {
    color: #75736f;
}

/* Multi-row tab buttons (MultiRowTabWidget) */
QPushButton#tabButton {
    background-color: #2d2c2b;
    color: #9a9792;
    border: 1px solid #484745;
    border-bottom: 2px solid #484745;
    border-radius: 4px;
    padding: 5px 8px;
}

QPushButton#tabButton:hover {
    background-color: #3d3c3a;
    color: #ebe9e6;
}

QPushButton#tabButton:checked {
    background-color: #4d4c4a;
    color: #ffffff;
    border-color: #5e5c59;
    border-bottom-color: #ebe9e6;
}

QPushButton#tabButton:focus {
    border-color: #3d95e0;
}

QPushButton#tabButton:disabled {
    color: #75736f;
}

/* Scrollbars */
QScrollBar {
    background-color: #282726;
    border: none;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle {
    background-color: #6e6c68;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    min-height: 30px;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
}

QScrollBar::handle:hover {
    background-color: #7a7874;
}

QScrollBar::handle:pressed {
    background-color: #8c8985;
}

QScrollBar::sub-line, QScrollBar::add-line,
QScrollBar::up-arrow, QScrollBar::down-arrow,
QScrollBar::add-page, QScrollBar::sub-page {
    height: 0px;
    width: 0px;
    background-color: transparent;
}

/* Sliders (styled to match scrollbars) */
QSlider::groove {
    background-color: #1f1e1d;
    border: none;
    border-radius: 6px;
}

QSlider::groove:horizontal {
    height: 12px;
}

QSlider::groove:vertical {
    width: 12px;
}

QSlider::handle {
    background-color: #6e6c68;
    border: none;
    border-radius: 6px;
}

QSlider::handle:horizontal {
    width: 80px;
    height: 12px;
}

QSlider::handle:vertical {
    height: 80px;
    width: 12px;
}

QSlider::handle:hover {
    background-color: #7a7874;
}

QSlider::handle:pressed {
    background-color: #8c8985;
}

QSlider::handle:disabled {
    background-color: #3c3b39;
}

/* Range slider: the selected range is a selection, so it keeps the accent */
QRangeSlider {
    background-color: transparent;
    height: 12px;
}

QRangeSlider::groove:horizontal {
    background-color: #3d95e0;
    border: none;
    height: 4px;
    margin: 4px 0;
}

QRangeSlider::handle:horizontal {
    background-color: #ebe9e6;
    width: 10px;
    height: 12px;
    margin: -4px 0;
}

QRangeSlider::handle:horizontal:hover {
    background-color: #c9c6c1;
}

QRangeSlider::handle:horizontal:pressed {
    background-color: #9a9792;
}

/* Progress bar: thin track with an accent fill */
QProgressBar {
    background-color: #1f1e1d;
    border: none;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar::chunk {
    background-color: #3d95e0;
    border-radius: 2px;
}
